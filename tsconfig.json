{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "preserve",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": [
    "**/*.ts",
    "**/*.tsx",
    "**/*.js",
    ".next/types/**/*.ts",
    "next-env.d.ts",
    "types/**/*.d.ts",
    ".next/next-build/types/**/*.ts"
, "src/app/home/components/HeroSection.tsx", "src/app/dashboard/apps/mdm/layout.jsx", "src/app/dashboard/apps/mdm/page.jsx", "src/modules/mdm/components/Header.jsx", "src/app/(dashboard)/apps/mdm/page.jsx", "src/app/(dashboard)/apps/layout.jsx", "src/app/(dashboard)/apps/mdm/contact/page.jsx", "src/app/(dashboard)/apps/mdm/profile/page.jsx"  ],
  "exclude": ["node_modules"]
}
